{
  "name": "curio-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Curio capture extension (MV3).",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "gate": "npm run typecheck && npm run lint && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.0"
  }
}
