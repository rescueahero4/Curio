{
  "manifest_version": 3,
  "name": "Curio Capture",
  "version": "0.1.3",
  "description": "Capture the current page into your Curio design inspiration library.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/curio-mark-16.png",
    "32": "icons/curio-mark-32.png",
    "48": "icons/curio-mark-48.png",
    "128": "icons/curio-mark-128.png"
  },
  "action": {
    "default_title": "Curio",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/curio-mark-16.png",
      "32": "icons/curio-mark-32.png",
      "48": "icons/curio-mark-48.png"
    }
  },
  "background": {
    "service_worker": "worker/service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "nativeMessaging", "scripting", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/pair", "http://localhost/pair"],
      "js": ["content/pair.js"],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
