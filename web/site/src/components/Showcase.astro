---
/**
 * The "See it in action" screenshots — a two-column grid.
 *
 * The design lays three shots at 554x344 across two columns with a 20px gutter, the third
 * wrapping to a second row. The columns are fractions rather than fixed pixels so the
 * pair keeps its gutter as the page narrows, and the grid collapses to one column on a
 * phone where two 554px shots cannot both be legible.
 *
 * Clicking a shot opens it full screen. Contents come from `../data/screenshots`.
 */
import { Image } from "astro:assets";
import { screenshots } from "../data/screenshots";

/** Design: 554x344 cells, 20px gutter, so the pair spans the 1128px content column. */
const CELL_W = 554;
const RATIO = "554 / 344";
---

<section class="showcase">
	<h2 class="showcase__label">See it in action</h2>

	<ul class="showcase__grid">
		{
			screenshots.map((shot, i) => (
				<li class="showcase__item">
					<button
						class="shot"
						type="button"
						data-open={i}
						aria-label={`Open screenshot ${i + 1} of ${screenshots.length} full screen: ${shot.caption}`}
					>
						<Image
							class="shot__img"
							src={shot.image}
							alt={shot.alt}
							width={CELL_W}
							densities={[1, 2]}
							loading={i === 0 ? "eager" : "lazy"}
						/>
					</button>
				</li>
			))
		}
	</ul>
</section>

<dialog class="lightbox" aria-label="Screenshot viewer">
	<div class="lightbox__bar">
		<p class="lightbox__counter" aria-live="polite">
			<span data-current>1</span> / {screenshots.length}
		</p>
		<button class="pill lightbox__close" type="button" data-close>Close</button>
	</div>

	<div class="lightbox__stage">
		<button class="pill lightbox__nav" type="button" data-step="-1" aria-label="Previous screenshot">←</button>

		<div class="lightbox__frames">
			{
				screenshots.map((shot, i) => (
					<figure class="lightbox__frame" data-frame={i} hidden>
						{/* Lazy + hidden: the large derivatives are not fetched until the
						    viewer is actually opened. */}
						<Image class="lightbox__img" src={shot.image} alt={shot.alt} width={1920} loading="lazy" />
						<figcaption class="lightbox__caption">{shot.caption}</figcaption>
					</figure>
				))
			}
		</div>

		<button class="pill lightbox__nav" type="button" data-step="1" aria-label="Next screenshot">→</button>
	</div>
</dialog>

<style define:vars={{ ratio: RATIO }}>
	.showcase__label {
		/* Bold 16px in the design — a section label, not a heading in the hero's scale. */
		font-size: var(--type-section);
		font-weight: 700;
		line-height: 1.2;
		margin: 0 0 var(--gap-section) 0;
	}

	.showcase__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 19px 20px;
		margin: 0;
		padding: 0;
		list-style: none;
		max-width: 1128px;
	}

	.shot {
		display: block;
		width: 100%;
		/* The design's 554x344 as a ratio, so a cell scales with its column instead of
		   holding a fixed height that would crop the image as the grid narrows. */
		aspect-ratio: var(--ratio);
		padding: 0;
		border: 1px solid var(--ink);
		border-radius: 4px;
		background: var(--paper);
		cursor: zoom-in;
		overflow: hidden;
	}

	.shot__img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top left;
	}

	.shot:hover,
	.shot:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}

	/* ---- full-screen viewer ---- */

	.lightbox {
		width: 100vw;
		max-width: 100vw;
		height: 100dvh;
		max-height: 100dvh;
		margin: 0;
		padding: 0;
		border: 0;
		background: var(--paper);
		color: var(--ink);
	}

	.lightbox::backdrop {
		background: rgb(0 0 0 / 0.72);
	}

	.lightbox__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 16px 24px;
	}

	.lightbox__counter {
		margin: 0;
		font-size: 14px;
	}

	.lightbox__stage {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 0 16px 24px;
		height: calc(100dvh - 62px);
	}

	.lightbox__frames {
		flex: 1 1 auto;
		min-width: 0;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.lightbox__frame {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		max-height: 100%;
	}

	.lightbox__frame[hidden] {
		display: none;
	}

	.lightbox__img {
		display: block;
		max-width: 100%;
		/* Leave room for the caption so a wide screenshot cannot push it off-screen. */
		max-height: calc(100% - 34px);
		width: auto;
		height: auto;
		object-fit: contain;
		border: 1px solid var(--ink);
	}

	.lightbox__caption {
		font-size: 14px;
		text-align: center;
		max-width: 70ch;
	}

	.lightbox__nav {
		flex: 0 0 auto;
		font-size: 18px;
		line-height: 1;
		padding: 10px 16px;
	}

	@media (max-width: 720px) {
		.lightbox__nav {
			padding: 8px 12px;
		}

		.lightbox__stage {
			padding: 0 8px 16px;
		}

		/* Two 554px shots side by side stop being readable well before this width; one
		   column keeps each one big enough to make out the app it is showing. */
		.showcase__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
	const frames = Array.from(document.querySelectorAll<HTMLElement>("[data-frame]"));
	const counter = document.querySelector<HTMLElement>("[data-current]");

	if (dialog && frames.length > 0) {
		let index = 0;

		const show = (next: number) => {
			// Wrap, so the arrows never dead-end on the first or last shot.
			index = (next + frames.length) % frames.length;
			frames.forEach((frame, i) => {
				frame.hidden = i !== index;
			});
			if (counter) counter.textContent = String(index + 1);
		};

		document.querySelectorAll<HTMLButtonElement>("[data-open]").forEach((button) => {
			button.addEventListener("click", () => {
				show(Number(button.dataset.open));
				dialog.showModal();
			});
		});

		document.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((button) => {
			button.addEventListener("click", () => show(index + Number(button.dataset.step)));
		});

		document.querySelector<HTMLButtonElement>("[data-close]")?.addEventListener("click", () => dialog.close());

		// Escape is handled by <dialog> itself; this adds the arrow keys.
		dialog.addEventListener("keydown", (event) => {
			if (event.key === "ArrowRight") {
				event.preventDefault();
				show(index + 1);
			} else if (event.key === "ArrowLeft") {
				event.preventDefault();
				show(index - 1);
			}
		});

		// Clicking the backdrop closes. The dialog fills the viewport, so a click lands on
		// the dialog element itself only when it missed everything inside it.
		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) dialog.close();
		});
	}
</script>
