---
/**
 * The landing page, implementing Figma node 18:217.
 *
 * Geometry is transcribed from the design's 1512px frame. Values the design states outright
 * (border widths, pill radii, the clone field's padding, the grid gutter) stay fixed; type
 * and the page inset scale with the viewport so the same proportions survive on a narrower
 * screen, which a single desktop frame does not specify.
 *
 * There is no documentation site behind this page any more — `docs/` is read on GitHub. The
 * only outbound links are the repository ones.
 */
import "@fontsource/inria-serif/400.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/base.css";

import Showcase from "../components/Showcase.astro";

// Icons come from Tabler upstream, not from the Figma export of them. The design names
// each one (`tabler:puzzle`, `tabler:terminal-2`, …), so the source set is the same
// artwork — but upstream ships a uniform 24x24 viewBox and `stroke="currentColor"`, where
// the exports carried baked-in black/white strokes, `preserveAspectRatio="none"`, and
// odd-sized leaves (terminal-2 came out 17x15.33). currentColor is what lets a button's
// own colour reach its icon, so a solid button needs no per-icon override.
//
// Inlined rather than <img src> so the stroke inherits and there is no request per icon.
import appleIcon from "@tabler/icons/outline/brand-apple.svg?raw";
import arrowIcon from "@tabler/icons/outline/arrow-right.svg?raw";
import bookmarksIcon from "@tabler/icons/outline/bookmarks.svg?raw";
import copyIcon from "@tabler/icons/outline/copy.svg?raw";
import forkIcon from "@tabler/icons/outline/grill-fork.svg?raw";
import githubIcon from "@tabler/icons/outline/brand-github.svg?raw";
import grainIcon from "@tabler/icons/outline/grain.svg?raw";
import puzzleIcon from "@tabler/icons/outline/puzzle.svg?raw";
import shareIcon from "@tabler/icons/outline/share.svg?raw";
import starIcon from "@tabler/icons/outline/star.svg?raw";
import terminalIcon from "@tabler/icons/outline/terminal-2.svg?raw";
import windowsIcon from "@tabler/icons/outline/brand-windows.svg?raw";

// The two that are not Tabler: the Curio crow, and the MCP mark (Tabler has no MCP glyph).
import birdIcon from "../assets/icons/bird.svg?raw";
import mcpIcon from "../assets/icons/mcp.svg?raw";

// Every destination outside this site lives in one file, so a moved release asset or a
// published extension listing is a one-line change there rather than a hunt through markup.
import { REPO, downloads } from "../data/downloads";

// Read at build, refreshed in the browser by the script at the foot of this file. See
// `repo-stats.ts` for why it is done twice.
import { fetchCounts, formatCount } from "../data/repo-stats";

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const CLONE_URL = "https://github.com/rescueahero4/Curio.git";

// What the Share button hands over. Built from the config rather than read from
// `location.href` in the browser, so a link arriving with a tracking query or a fragment
// does not get passed along to whoever it is shared with.
const SHARE_URL = new URL(`${BASE}/`, Astro.site).href;

const counts = await fetchCounts();

/** The Collect → Connect → Produce flow. Labels only; the arrows are decoration. */
const flow = [
	{ icon: bookmarksIcon, label: "Collect", size: "24" },
	{ icon: mcpIcon, label: "Connect", size: "22" },
	{ icon: grainIcon, label: "Produce", size: "24" },
];

const title = "Curio — free opensource local-first design inspiration library";
const description =
	"Free opensource personal local-first design inspiration library. Capture design references, let a vision model describe them in your own vocabulary, and compose prompts from it — all on your machine.";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href={`${BASE}/favicon.svg`} type="image/svg+xml" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
	</head>

	<body>
		<div class="frame">
			<main>
				<div class="lockup">
					<span class="lockup__bird" set:html={birdIcon} />
					<span class="lockup__word">Curio</span>
					{/*
						The count groups are always in the markup, hidden when there is no number, so
						the browser has something to fill in even when the build-time fetch came back
						empty — and if both fetches fail the pill reads exactly as it did before the
						count existed rather than showing a divider with nothing after it.

						The glyph is decorative and the unit is a hidden word, so this reads as
						"GitHub, 128 stars" rather than as an icon a screen reader has to name.
					*/}
					<a class="pill lockup__gh" href={REPO}>
						<span class="icon icon--24" set:html={githubIcon} />
						GitHub
						<span class="pill__count" hidden={counts.stars === null}>
							<span class="icon icon--16" aria-hidden="true" set:html={starIcon} />
							<span data-count="stars">{counts.stars === null ? "" : formatCount(counts.stars)}</span>
							<span class="sr-only"> stars</span>
						</span>
					</a>

					{/*
						A button, not a link: it has no destination of its own. Its own label is what
						confirms a copy — a toast under the lockup, the way the clone field does it,
						would land on the headline, which starts 17px below.
					*/}
					<button class="pill lockup__share" type="button" data-share={SHARE_URL} data-share-title={title}>
						<span class="icon icon--24" set:html={shareIcon} />
						<span class="pill__label" aria-live="polite">Share</span>
					</button>
				</div>

				<h1 class="headline">Free opensource personal local-first design inspiration library.</h1>

				<p class="lede">
					As more and more designers embrace developer tools, Curio bridges the widening gaps of traditional
					moodboarding and inspiration libraries that are often disconnected from local agentic design pipelines
				</p>

				<div class="ctas">
					{/*
						These two download the installer outright rather than opening the releases
						page. No `download` attribute: it is ignored cross-origin, and GitHub already
						sends `Content-Disposition: attachment`, so a plain href is what works.
					*/}
					<a class="pill pill--solid" href={downloads.windows}>
						<span class="icon icon--24" set:html={windowsIcon} />
						Get Windows
					</a>
					<a class="pill pill--solid" href={downloads.macos}>
						<span class="icon icon--24" set:html={appleIcon} />
						Get Mac App
					</a>
					<a class="pill pill--solid" href={downloads.extension}>
						<span class="icon icon--24" set:html={puzzleIcon} />
						Get Browser Extension
					</a>
					{/*
						The fork glyph sits with the count rather than in the leading position the
						other three buttons use — it labels the number, not the button, whose own
						wording already says what it does. Alone among the four, this pill carries no
						leading icon; that is deliberate, and it is why the group hides whole when
						the count is unknown rather than leaving a lone glyph behind a divider.
					*/}
					<a class="pill pill--fork" href={`${REPO}/fork`}>
						Fork from Github
						<span class="pill__count" hidden={counts.forks === null}>
							<span class="icon icon--16" aria-hidden="true" set:html={forkIcon} />
							<span data-count="forks">{counts.forks === null ? "" : formatCount(counts.forks)}</span>
							<span class="sr-only"> forks</span>
						</span>
					</a>
				</div>

				{/*
					Not in the Figma frame. Both installers are unsigned — Apple gates Developer ID
					behind a paid membership with no open-source exemption (D34) — so the first thing
					that happens after either button is a SmartScreen or Gatekeeper warning. Saying so
					here, next to the buttons, is what stops that reading as a broken download.
				*/}
				<p class="unsigned">
					Unsigned free builds, see <a href={downloads.installGuide}>install guide</a>
				</p>

				<section class="clone">
					<h2 class="clone__label">
						<span class="icon icon--20" set:html={terminalIcon} />
						Clone
					</h2>

					<div class="clone__field">
						<code class="clone__url">{CLONE_URL}</code>
						<button class="clone__copy" type="button" data-clone={CLONE_URL} aria-label="Copy clone URL to clipboard">
							<span class="icon icon--24" set:html={copyIcon} />
						</button>
					</div>

					{/* Announced to screen readers and shown as text; the icon alone cannot report success. */}
					<p class="clone__status" role="status" aria-live="polite"></p>
				</section>

				<section class="howto">
					<h2 class="section-label">How to use</h2>

					<ul class="flow">
						{
							flow.map((step, i) => (
								<li class="flow__step">
									<span class={`icon icon--${step.size}`} set:html={step.icon} />
									{step.label}
									{i < flow.length - 1 && <span class="icon flow__arrow" aria-hidden="true" set:html={arrowIcon} />}
								</li>
							))
						}
					</ul>

					<ol class="steps">
						<li>Download App, and install Browser Extension - or build app locally by forking repo</li>
						<li>Use <a href={downloads.extension}>Curio browser extension</a> to screenshot and curate design inspirations</li>
						<li>Connect AI apps via Curio’s built-in MCP</li>
						<li>Use Curio’s prompt builder which links your library to your AI apps</li>
					</ol>
				</section>

				<Showcase />
			</main>

			{/*
				Not in the Figma frame, which has no footer. Added because a privacy policy that
				nothing links to is only findable by whoever already has the URL — and the Chrome
				Web Store listing points at it, so reviewers and users both arrive looking.
			*/}
			<footer class="footer">
				<a href={`${BASE}/privacy/`}>Privacy</a>
				<a href={`${BASE}/terms/`}>Terms of Use</a>
				<a href={REPO}>GitHub</a>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	/* Tokens, reset and body live in src/styles/base.css, imported above and shared with
	   every other page. What stays here is what only this page draws. */

	/* Every rule that targets an inlined <svg> lives in this global block, and must.
	   Astro's scoped styles compile a child selector to `svg:where(.astro-hash)`, and markup
	   injected with `set:html` never receives that hash — so the same rule written in a
	   scoped block silently does nothing. It cost a half-turn on the crow once; keep SVG
	   selectors here. */
	.icon {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
	}

	/* Tabler draws on a uniform 24x24 viewBox with `stroke="currentColor"`, so sizing is
	   one width/height pair and colour needs no rule at all — each icon inherits from the
	   button or text it sits in. */
	.icon > svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Only the count glyphs. 24 is the button size; beside 13px digits it would outweigh
	   them, and the pair has to read as one unit. */
	.icon--16 {
		width: 16px;
		height: 16px;
	}

	.icon--20 {
		width: 20px;
		height: 20px;
	}

	.icon--22 {
		width: 22px;
		height: 22px;
	}

	.icon--24 {
		width: 24px;
		height: 24px;
	}

	.lockup__bird > svg {
		width: 50.624px;
		height: 45.925px;
		/* Required, not decorative. The export carries the path data unrotated while the
		   Figma node is rotated a half-turn, so without this the crow stands on its head —
		   confirmed against both the design and assets/brand/curio-mark.svg. The box is
		   symmetric about its centre, so this changes orientation only, not position. */
		transform: rotate(180deg);
	}

	.flow__arrow {
		width: 24px;
		height: 24px;
	}
</style>

<style>
	.frame {
		max-width: var(--frame);
		margin-inline: auto;
		padding-inline: var(--pad-inline);
		padding-bottom: 96px;
	}

	/* ---- wordmark lockup ---- */

	.lockup {
		position: relative;
		display: flex;
		align-items: center;
		gap: 10px;
		/* The bird's box starts at y=104 and the word at y=127: the mark overlaps the top
		   of the "C" by 23px, which is the lockup. */
		margin-top: 104px;
		padding-top: 23px;
		/* The design sets the mark and the word at x=188 while the copy below starts at
		   197. That 9px is the serif "C"'s left side bearing — pulling the lockup out by it
		   puts the glyph's visible edge on the column, not its box. */
		margin-left: -9px;
	}

	.lockup__bird {
		position: absolute;
		top: -9px;
		left: -1px;
		display: block;
	}

	.lockup__word {
		font-family: "Inria Serif", Georgia, serif;
		font-size: var(--type-word);
		line-height: 1;
	}

	.lockup__gh,
	.lockup__share {
		/* The design drops the pill below the wordmark's optical centre, level with the
		   x-height rather than the full line box. */
		align-self: flex-end;
		margin-bottom: 1px;
	}

	/* "Share" and "Copied" are a character apart, and the pill is centred, so letting it
	   resize would shift its own label under the pointer mid-click. Holding the wider of
	   the two keeps the row still. */
	.pill__label {
		min-width: 6ch;
		text-align: center;
	}

	/* ---- pills ---- */

	.pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		min-height: 36px;
		padding: 6px 12px;
		border: 1px solid var(--ink);
		border-radius: 100px;
		background: var(--paper);
		color: var(--ink);
		font-family: inherit;
		font-size: 14px;
		line-height: normal;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
	}

	.pill--solid {
		background: var(--solid);
		color: var(--paper);
	}

	/* Outline in the design, unlike the three download buttons beside it — forking is the
	   alternative to downloading, not a fourth download. */
	.pill--fork {
		color: var(--fork-ink);
	}

	/* Not in the Figma frame. A hairline in the pill's own colour — so it inverts with the
	   rest on hover — separates the count from the label, and the mono face at a step down
	   keeps it reading as metadata rather than as part of the button's name. Tabular figures
	   stop the pill twitching when the live count replaces the built one. */
	.pill__count {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding-left: 8px;
		border-left: 1px solid currentColor;
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-weight: 500;
		font-size: 13px;
		font-variant-numeric: tabular-nums;
		opacity: 0.7;
	}

	/* `hidden` alone loses to `display: inline-flex` above. */
	.pill__count[hidden] {
		display: none;
	}

	/* Carries the unit — "stars", "forks" — to a screen reader without putting the word in
	   the pill, where the icon already says it. Clipped rather than `display: none`, which
	   would take it out of the accessibility tree along with the layout. */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.pill:hover {
		background: var(--ink);
		color: var(--paper);
	}

	.pill:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}

	/* ---- hero copy ---- */

	.headline {
		max-width: 889px;
		margin: 17px 0 0;
		font-size: var(--type-h1);
		font-weight: 400;
		line-height: 1.2;
	}

	.lede {
		max-width: 889px;
		margin: 11px 0 0;
		font-size: var(--type-lede);
		/* 26px on 18px type. */
		line-height: 1.444;
	}

	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 29px;
	}

	/* Tight to the buttons, because it is a caption for them rather than a section of its
	   own — the design's 30px to Clone then still reads as the break. This is new content,
	   so everything below it moves down by its height; nothing there is positioned
	   absolutely, so that is the whole consequence. */
	.unsigned {
		margin: 10px 0 0;
		font-size: 14px;
		color: var(--muted);
	}

	.unsigned a {
		color: var(--ink);
		text-decoration: underline;
		text-underline-position: from-font;
	}

	/* ---- clone ---- */

	.clone {
		position: relative;
		max-width: 466px;
		margin-top: 30px;
	}

	.clone__label {
		display: flex;
		align-items: center;
		gap: 7px;
		margin: 0;
		font-size: var(--type-body);
		font-weight: 400;
		line-height: 1.2;
	}

	.clone__field {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: 13px;
		padding: 10px 16px;
		border-radius: 12px;
		background: var(--field);
	}

	.clone__url {
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-weight: 500;
		font-size: 14px;
		/* The URL is the point of the field; let it shrink and scroll rather than push the
		   copy button out of the box on a narrow screen. */
		overflow-x: auto;
		white-space: nowrap;
	}

	.clone__copy {
		display: inline-flex;
		flex: 0 0 auto;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		cursor: pointer;
		border-radius: 4px;
	}

	.clone__copy:hover {
		opacity: 0.65;
	}

	.clone__copy:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}

	/* Taken out of flow deliberately. In flow, its reserved line sat between the clone
	   field and "How to use" and pushed everything below it 23px down the page; as an
	   overlay it reports the copy without moving the layout, and the 48px gap under the
	   field leaves room for it. */
	.clone__status {
		position: absolute;
		top: calc(100% + 6px);
		left: 0;
		margin: 0;
		font-size: 14px;
	}

	/* ---- how to use ---- */

	.howto {
		margin-top: 48px;
	}

	.section-label {
		margin: 0;
		font-size: var(--type-section);
		font-weight: 700;
		line-height: 1.2;
	}

	.flow {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 9px;
		margin: 11px 0 0;
		padding: 0;
		list-style: none;
	}

	.flow__step {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-size: var(--type-feature);
	}

	.flow__arrow {
		display: inline-flex;
		/* The design spaces the arrow 10px from the label it follows and 9px from the next
		   step, which the list gap supplies. */
		margin-left: 10px;
	}

	.steps {
		margin: 8px 0 0;
		padding-left: 24px;
		max-width: 889px;
		font-size: var(--type-body);
		/* 26px on 16px type. */
		line-height: 1.625;
	}

	.steps a {
		text-decoration: underline;
		text-underline-position: from-font;
	}

	/* ---- showcase ---- */

	:global(.showcase) {
		margin-top: 48px;
	}

	/* ---- footer ---- */

	.footer {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		margin-top: 64px;
		padding-top: 20px;
		border-top: 1px solid var(--ink);
		font-size: 14px;
	}

	@media (max-width: 560px) {
		.ctas {
			gap: 10px;
		}

		.lockup {
			flex-wrap: wrap;
			gap: 10px;
		}

		.lockup__gh,
		.lockup__share {
			align-self: center;
			margin-bottom: 0;
		}
	}
</style>

<script>
	import { REPO_API, formatCount } from "../data/repo-stats";

	// The numbers in the markup are as old as the last Pages deploy. One request brings them
	// up to date; if it fails — offline, rate-limited, GitHub down — the built-in counts stay
	// exactly as rendered, which is the whole reason they are rendered at all.
	const slots = document.querySelectorAll<HTMLElement>("[data-count]");

	if (slots.length) {
		fetch(REPO_API, { headers: { accept: "application/vnd.github+json" } })
			.then((response) => (response.ok ? response.json() : null))
			.then((body) => {
				if (!body) return;

				const live: Record<string, unknown> = {
					stars: body.stargazers_count,
					forks: body.forks_count,
				};

				for (const slot of slots) {
					const value = live[slot.dataset.count ?? ""];
					if (typeof value !== "number") continue;
					// The slot holds only the digits; the icon and the screen-reader unit are its
					// siblings, so the group — not the slot — is what carries `hidden`.
					slot.textContent = formatCount(value);
					const group = slot.closest<HTMLElement>(".pill__count");
					if (group) group.hidden = false;
				}
			})
			.catch(() => {
				/* Keep the build-time counts. */
			});
	}

	const share = document.querySelector<HTMLButtonElement>("[data-share]");

	if (share) {
		const label = share.querySelector<HTMLElement>(".pill__label");
		const idle = label?.textContent ?? "Share";
		let restore: ReturnType<typeof setTimeout> | undefined;

		const flash = (message: string) => {
			if (!label) return;
			label.textContent = message;
			clearTimeout(restore);
			restore = setTimeout(() => {
				label.textContent = idle;
			}, 2500);
		};

		share.addEventListener("click", async () => {
			const url = share.dataset.share ?? "";
			const title = share.dataset.shareTitle ?? document.title;

			// Where the OS has a share sheet, that sheet is the whole interaction and the
			// button says nothing — Firefox and desktop Safari have no `navigator.share`, and
			// fall through to the clipboard.
			if (navigator.share) {
				try {
					await navigator.share({ title, url });
					return;
				} catch (error) {
					// Dismissing the sheet rejects with AbortError. That is a finished
					// interaction, not a failure, so it must not fall through and copy a link
					// the person just decided not to share.
					if (error instanceof DOMException && error.name === "AbortError") return;
				}
			}

			try {
				await navigator.clipboard.writeText(url);
				flash("Copied");
			} catch {
				// Same constraint as the clone field: the clipboard needs a secure context and
				// permission. There is no text node to fall back to selecting here, so the
				// button says what happened rather than offering a keystroke that would copy
				// whatever the person had selected instead.
				flash("Blocked");
			}
		});
	}

	const button = document.querySelector<HTMLButtonElement>("[data-clone]");
	const status = document.querySelector<HTMLElement>(".clone__status");

	if (button) {
		let clear: ReturnType<typeof setTimeout> | undefined;

		const report = (message: string) => {
			if (!status) return;
			status.textContent = message;
			clearTimeout(clear);
			clear = setTimeout(() => {
				status.textContent = "";
			}, 2500);
		};

		button.addEventListener("click", async () => {
			const url = button.dataset.clone ?? "";
			try {
				await navigator.clipboard.writeText(url);
				report("Copied to clipboard");
			} catch {
				// Clipboard access needs a secure context and permission; on refusal, say so
				// rather than claiming a copy that did not happen.
				report("Press Ctrl/Cmd+C to copy");
				const url_node = document.querySelector(".clone__url");
				if (url_node) {
					const range = document.createRange();
					range.selectNodeContents(url_node);
					const selection = window.getSelection();
					selection?.removeAllRanges();
					selection?.addRange(range);
				}
			}
		});
	}
</script>
