docs/_convo

# Secrets — R-DEL-17. Nothing resembling a credential enters this repo.
.env
.env*
/.env
.secrets.json

# Run state — machine-written, per-run, never committed (R-DA-2).
runtime.json
curio.lock

# Rust
/target
**/*.rs.bk

# Node
node_modules/
web/spa/dist/
web/extension/dist/
web/site/dist/
web/site/.astro/
*.tsbuildinfo

# Site pages copied from docs/ by web/site/scripts/sync-docs.mjs on every build.
# docs/ is the source of truth (R-DEL-18); committing the copies would let the two
# drift, which is the failure that rule exists to prevent.
web/site/src/content/docs/architecture/
web/site/src/content/docs/product/

# Local databases and captures — never test against a real library in-tree.
*.db
*.db-wal
*.db-shm

# OS
.DS_Store
Thumbs.db

# graphify: regenerable AST extraction cache
graphify-out
graphify-out/cache/

